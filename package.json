{
  "name": "erp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:tz": "turbo run test:tz",
    "db:generate": "turbo run db:generate --filter=@erp/api",
    "db:migrate": "turbo run db:migrate --filter=@erp/api",
    "db:seed": "turbo run db:seed --filter=@erp/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0"
}
