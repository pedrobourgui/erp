generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum TenantPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum ProductType {
  SIMPLE
  VARIABLE
  KIT
  SERVICE
}

enum MovementType {
  ENTRY
  EXIT
  TRANSFER
  ADJUSTMENT
  RETURN
  PRODUCTION
}

enum MovementReason {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
  RETURN_CUSTOMER
  RETURN_SUPPLIER
  DAMAGE
  THEFT
  PRODUCTION
  INITIAL
  COUNT
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PICKING
  PACKED
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
}

enum OrderOrigin {
  MANUAL
  BALCAO
  MERCADO_LIVRE
  SHOPEE
  AMAZON
  MAGALU
  SHOPIFY
  NUVEMSHOP
  WOOCOMMERCE
  API
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT_TO_SUPPLIER
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum FinancialType {
  RECEIVABLE
  PAYABLE
}

enum FinancialStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum InvoiceType {
  NFE
  NFCE
  NFSE
}

enum InvoiceStatus {
  DRAFT
  PROCESSING
  AUTHORIZED
  CANCELLED
  DENIED
  CORRECTED
}

enum TaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
}

enum MarketplaceType {
  MERCADO_LIVRE
  SHOPEE
  AMAZON
  MAGALU
  SHOPIFY
  NUVEMSHOP
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
  PARTIAL
}

enum ListingStatus {
  ACTIVE
  PAUSED
  CLOSED
  UNDER_REVIEW
  DELETED
}

enum NotificationType {
  IN_APP
  EMAIL
  WEBHOOK
  SMS
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum InteractionType {
  NOTE
  CALL
  EMAIL
  MEETING
  WHATSAPP
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CASH
  DIGITAL
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  UNMATCHED
  IGNORED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

enum PaymentMethodType {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BOLETO
  BANK_TRANSFER
  CHECK
  STORE_CREDIT
  OTHER
}

enum PaymentConditionType {
  CASH
  INSTALLMENT
  ENTRY_PLUS_INSTALLMENT
}

enum CashMovementType {
  SUPPLY
  WITHDRAW
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

// ==========================================
// CORE: Tenants, Users, Roles, Permissions
// ==========================================

/// Multi-tenant: cada empresa é um tenant isolado
model Tenant {
  id        String       @id @default(cuid())
  name      String
  document  String       // CNPJ
  email     String
  phone     String?
  plan      TenantPlan   @default(TRIAL)
  status    TenantStatus @default(ACTIVE)
  taxRegime TaxRegime    @default(SIMPLES_NACIONAL)

  // Limites do plano
  maxUsers      Int @default(5)
  maxProducts   Int @default(500)
  maxOrders     Int @default(1000) // por mês
  maxWarehouses Int @default(1)

  // Configurações gerais (JSON flexível)
  settings Json @default("{}")

  // Endereço
  addressStreet  String?
  addressNumber  String?
  addressComplement String?
  addressNeighborhood String?
  addressCity    String?
  addressState   String?
  addressZipCode String?

  trialEndsAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users                User[]
  roles                Role[]
  products             Product[]
  categories           Category[]
  brands               Brand[]
  suppliers            Supplier[]
  warehouses           Warehouse[]
  orders               Order[]
  quotations           Quotation[]
  purchaseOrders       PurchaseOrder[]
  financialAccounts    FinancialAccount[]
  accountsReceivable   AccountsReceivable[]
  accountsPayable      AccountsPayable[]
  financialTransactions FinancialTransaction[]
  invoices             Invoice[]
  taxRules             TaxRule[]
  cfops                Cfop[]
  customers            Customer[]
  leads                Lead[]
  marketplaceConnections MarketplaceConnection[]
  notifications        Notification[]
  salesChannels        SalesChannel[]
  costCenters          CostCenter[]
  chartOfAccounts      ChartOfAccounts[]
  auditLogs            AuditLog[]
  paymentMethods       PaymentMethod[]
  paymentConditions    PaymentCondition[]
  orderPayments        OrderPayment[]
  cashRegisters        CashRegister[]
  cashRegisterSessions CashRegisterSession[]
  cashRegisterMovements CashRegisterMovement[]

  @@index([document])
  @@index([status])
  @@map("tenants")
}

/// Usuários do sistema com vínculo a um tenant
model User {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email     String
  password  String     // bcrypt hash
  name      String
  avatar    String?
  phone     String?
  status    UserStatus @default(ACTIVE)

  lastLoginAt DateTime?
  lastLoginIp String?

  roleId    String?
  role      Role?      @relation(fields: [roleId], references: [id])

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  orders           Order[]
  auditLogs        AuditLog[]
  inventoryMovements InventoryMovement[]
  customerInteractions CustomerInteraction[]
  notifications    Notification[]
  cashSessionsOperated  CashRegisterSession[] @relation("SessionOperator")
  cashSessionsClosed    CashRegisterSession[] @relation("SessionCloser")
  cashMovementsPerformed CashRegisterMovement[] @relation("MovementPerformedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

/// Papéis de acesso por tenant
model Role {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String   // owner, admin, manager, seller, warehouse, financial, viewer
  description String?
  isSystem    Boolean  @default(false) // roles padrão não podem ser deletados

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/// Permissões disponíveis no sistema
model Permission {
  id       String @id @default(cuid())
  resource String // products, orders, financial, etc.
  action   String // create, read, update, delete, export

  description String?

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

/// Associação Role <-> Permission
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// Log de auditoria para rastreio completo
model AuditLog {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?       @relation(fields: [userId], references: [id])

  entity    String      // nome da tabela
  entityId  String      // ID do registro
  action    AuditAction

  oldData   Json?       // dados antes da alteração
  newData   Json?       // dados depois da alteração
  diff      Json?       // diff calculado

  ip        String?
  userAgent String?
  metadata  Json?       // dados extras

  createdAt DateTime    @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ==========================================
// PRODUTOS E ESTOQUE
// ==========================================

/// Categorias de produtos (hierárquica)
model Category {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  slug      String
  parentId  String?
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  products  Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

/// Marcas
model Brand {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  logo      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("brands")
}

/// Fornecedores
model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String
  tradeName    String?  // nome fantasia
  document     String   // CNPJ/CPF
  email        String?
  phone        String?
  website      String?

  addressStreet  String?
  addressNumber  String?
  addressCity    String?
  addressState   String?
  addressZipCode String?

  notes     String?
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  products        Product[]
  purchaseOrders  PurchaseOrder[]
  contacts        SupplierContact[]
  accountsPayable AccountsPayable[]

  @@index([tenantId])
  @@index([tenantId, document])
  @@map("suppliers")
}

/// Contatos de fornecedores
model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  name       String
  email      String?
  phone      String?
  role       String?  // compras, financeiro, etc.

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("supplier_contacts")
}

/// Produto principal
model Product {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sku       String
  name      String
  description String?
  type      ProductType   @default(SIMPLE)
  status    ProductStatus @default(DRAFT)

  // Códigos fiscais
  ean       String?       // EAN/GTIN (código de barras)
  ncm       String?       // NCM (classificação fiscal)
  cest      String?       // CEST

  // Preços
  costPrice    Decimal  @default(0) @db.Decimal(15, 4)
  salePrice    Decimal  @default(0) @db.Decimal(15, 4)
  promoPrice   Decimal? @db.Decimal(15, 4)
  markup       Decimal? @db.Decimal(10, 4)

  // Dimensões e peso
  weight    Decimal? @db.Decimal(10, 3) // kg
  height    Decimal? @db.Decimal(10, 2) // cm
  width     Decimal? @db.Decimal(10, 2)
  length    Decimal? @db.Decimal(10, 2)

  // Estoque
  // Mínimo padrão do produto: semeia o minStock de cada InventoryItem criado.
  // O item pode ter um mínimo próprio, que prevalece sobre este.
  defaultMinStock Int @default(0)

  // Organização
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id])
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  // Busca full-text
  searchVector String? // tsvector será gerenciado via raw SQL

  // Metadados flexíveis
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  variants           ProductVariant[]
  images             ProductImage[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  stockAlerts        StockAlert[]
  orderItems         OrderItem[]
  quotationItems     QuotationItem[]
  purchaseOrderItems PurchaseOrderItem[]
  marketplaceListings MarketplaceListing[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, ean])
  @@map("products")
}

/// Variantes de produto (cor, tamanho, etc.)
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku       String
  name      String   // Ex: "Azul - M"
  ean       String?

  costPrice  Decimal? @db.Decimal(15, 4)
  salePrice  Decimal? @db.Decimal(15, 4)

  // Atributos da variação
  attributes Json    // { "cor": "Azul", "tamanho": "M" }

  weight    Decimal? @db.Decimal(10, 3)
  height    Decimal? @db.Decimal(10, 2)
  width     Decimal? @db.Decimal(10, 2)
  length    Decimal? @db.Decimal(10, 2)

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems InventoryItem[]
  orderItems     OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

/// Imagens do produto
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  key       String   // chave no S3/MinIO
  position  Int      @default(0)
  isMain    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

/// Depósitos / Armazéns
model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  code      String
  address   String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems  InventoryItem[]
  movementsFrom   InventoryMovement[] @relation("MovementFrom")
  movementsTo     InventoryMovement[] @relation("MovementTo")
  stockAlerts     StockAlert[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

/// Estoque por produto/variante e depósito
model InventoryItem {
  id          String   @id @default(cuid())
  tenantId    String

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  quantity    Int      @default(0) // estoque total
  reserved    Int      @default(0) // reservado por pedidos
  available   Int      @default(0) // quantity - reserved
  minStock    Int      @default(0)
  maxStock    Int?

  costAverage Decimal  @default(0) @db.Decimal(15, 4) // custo médio

  lastCountAt DateTime? // última contagem de inventário

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, variantId, warehouseId])
  @@index([tenantId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, quantity]) // para alertas de estoque baixo
  @@map("inventory_items")
}

/// Movimentações de estoque (rastreio completo)
model InventoryMovement {
  id            String         @id @default(cuid())
  tenantId      String

  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  type          MovementType
  reason        MovementReason

  quantity      Int
  unitCost      Decimal?       @db.Decimal(15, 4)
  totalCost     Decimal?       @db.Decimal(15, 4)

  fromWarehouseId String?
  fromWarehouse   Warehouse?   @relation("MovementFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse?   @relation("MovementTo", fields: [toWarehouseId], references: [id])

  // Referência (pedido, compra, ajuste)
  referenceType String?        // order, purchase_order, adjustment
  referenceId   String?

  notes         String?
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])

  createdAt     DateTime       @default(now())

  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

/// Alertas de estoque
model StockAlert {
  id          String   @id @default(cuid())
  tenantId    String

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  currentQty  Int
  minStock    Int
  isResolved  Boolean  @default(false)
  resolvedAt  DateTime?

  createdAt   DateTime @default(now())

  @@index([tenantId, isResolved])
  @@map("stock_alerts")
}

// ==========================================
// VENDAS E PEDIDOS
// ==========================================

/// Canais de venda configurados
model SalesChannel {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  type      OrderOrigin
  isActive  Boolean  @default(true)

  // Configurações específicas do canal
  settings  Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([tenantId])
  @@map("sales_channels")
}

/// Pedidos de venda
model Order {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderNumber   String      // número sequencial por tenant
  status        OrderStatus @default(DRAFT)
  origin        OrderOrigin @default(MANUAL)

  // Cliente
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])

  // Canal
  salesChannelId String?
  salesChannel   SalesChannel? @relation(fields: [salesChannelId], references: [id])

  // Vendedor
  sellerId      String?
  seller        User?       @relation(fields: [sellerId], references: [id])

  // Sessão de caixa (venda de balcão) — vincula a venda em dinheiro à sessão
  // aberta no momento da criação, para conciliação do caixa no fechamento.
  cashRegisterSessionId String?
  cashRegisterSession   CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id])

  // Marketplace
  marketplaceOrderId String? // ID do pedido no marketplace
  marketplaceData    Json?   // dados extras do marketplace

  // Valores
  subtotal      Decimal     @default(0) @db.Decimal(15, 2)
  discount      Decimal     @default(0) @db.Decimal(15, 2)
  shippingCost  Decimal     @default(0) @db.Decimal(15, 2)
  totalAmount   Decimal     @default(0) @db.Decimal(15, 2)

  // Frete
  shippingMethod   String?
  trackingCode     String?
  trackingUrl      String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  estimatedDelivery DateTime?

  // Endereço de entrega
  shippingAddress  Json?

  notes         String?
  internalNotes String?
  metadata      Json?

  cancelledAt   DateTime?
  cancelReason  String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  invoices       Invoice[]
  receivables    AccountsReceivable[]
  payments       OrderPayment[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, origin])
  @@index([tenantId, createdAt])
  @@index([tenantId, marketplaceOrderId])
  @@index([cashRegisterSessionId])
  @@map("orders")
}

/// Itens do pedido
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  sku       String
  name      String
  quantity  Int
  unitPrice Decimal  @db.Decimal(15, 2)
  discount  Decimal  @default(0) @db.Decimal(15, 2)
  totalPrice Decimal @db.Decimal(15, 2)

  // Fiscal
  ncm       String?
  cfop      String?

  metadata  Json?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Histórico de status do pedido
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus
  notes      String?
  changedBy  String?     // userId

  createdAt  DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

/// Orçamentos
model Quotation {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  quotationNumber String
  status        QuotationStatus @default(DRAFT)
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id])

  subtotal      Decimal         @default(0) @db.Decimal(15, 2)
  discount      Decimal         @default(0) @db.Decimal(15, 2)
  totalAmount   Decimal         @default(0) @db.Decimal(15, 2)

  validUntil    DateTime?
  notes         String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  items         QuotationItem[]

  @@unique([tenantId, quotationNumber])
  @@index([tenantId])
  @@map("quotations")
}

/// Itens do orçamento
model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  productId    String
  product      Product   @relation(fields: [productId], references: [id])

  quantity     Int
  unitPrice    Decimal   @db.Decimal(15, 2)
  discount     Decimal   @default(0) @db.Decimal(15, 2)
  totalPrice   Decimal   @db.Decimal(15, 2)

  @@map("quotation_items")
}

// ==========================================
// COMPRAS
// ==========================================

/// Ordens de compra
model PurchaseOrder {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderNumber   String
  status        PurchaseOrderStatus @default(DRAFT)

  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])

  subtotal      Decimal             @default(0) @db.Decimal(15, 2)
  discount      Decimal             @default(0) @db.Decimal(15, 2)
  shippingCost  Decimal             @default(0) @db.Decimal(15, 2)
  totalAmount   Decimal             @default(0) @db.Decimal(15, 2)

  expectedDate  DateTime?
  receivedDate  DateTime?
  notes         String?

  approvedBy    String?
  approvedAt    DateTime?

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  items         PurchaseOrderItem[]
  payables      AccountsPayable[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

/// Itens da ordem de compra
model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId       String
  product         Product       @relation(fields: [productId], references: [id])

  quantity        Int
  receivedQty     Int           @default(0)
  unitCost        Decimal       @db.Decimal(15, 4)
  totalCost       Decimal       @db.Decimal(15, 4)

  @@map("purchase_order_items")
}

// ==========================================
// FINANCEIRO
// ==========================================

/// Contas bancárias e caixas
model FinancialAccount {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name              String
  type              BankAccountType
  code              String?         @db.VarChar(20)
  bankName          String?
  bankBranch        String?
  bankAccount       String?
  balance           Decimal         @default(0) @db.Decimal(15, 2)
  isActive          Boolean         @default(true)
  acceptsDirectSales Boolean        @default(false)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  transactions      FinancialTransaction[]
  reconciliations   BankReconciliation[]
  paymentMethods    PaymentMethod[]
  orderPayments     OrderPayment[]
  cashRegisters     CashRegister[]

  @@index([tenantId])
  @@map("financial_accounts")
}

/// Contas a receber
model AccountsReceivable {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderId          String?
  order            Order?          @relation(fields: [orderId], references: [id])
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id])
  orderPaymentId   String?
  orderPayment     OrderPayment?   @relation(fields: [orderPaymentId], references: [id])

  description String
  installment Int             @default(1) // parcela atual
  totalInstallments Int       @default(1)
  amount      Decimal         @db.Decimal(15, 2)
  paidAmount  Decimal         @default(0) @db.Decimal(15, 2)
  status      FinancialStatus @default(PENDING)

  dueDate     DateTime
  paidAt      DateTime?

  // Juros e multa
  interestRate Decimal?       @db.Decimal(5, 2)  // % ao mês
  fineRate     Decimal?       @db.Decimal(5, 2)  // %
  interestAmount Decimal      @default(0) @db.Decimal(15, 2)
  fineAmount   Decimal        @default(0) @db.Decimal(15, 2)

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  costCenterId String?
  costCenter   CostCenter?    @relation(fields: [costCenterId], references: [id])
  chartAccountId String?
  chartAccount   ChartOfAccounts? @relation(fields: [chartAccountId], references: [id])

  notes       String?
  metadata    Json?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, customerId])
  @@map("accounts_receivable")
}

/// Contas a pagar
model AccountsPayable {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplierId  String?
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])

  description String
  installment Int             @default(1)
  totalInstallments Int       @default(1)
  amount      Decimal         @db.Decimal(15, 2)
  paidAmount  Decimal         @default(0) @db.Decimal(15, 2)
  status      FinancialStatus @default(PENDING)

  dueDate     DateTime
  paidAt      DateTime?
  scheduledDate DateTime?     // agendamento de pagamento

  approvalLevel Int           @default(0) // nível de aprovação necessário
  approvedBy    String?
  approvedAt    DateTime?

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  costCenterId String?
  costCenter   CostCenter?    @relation(fields: [costCenterId], references: [id])
  chartAccountId String?
  chartAccount   ChartOfAccounts? @relation(fields: [chartAccountId], references: [id])

  notes       String?
  metadata    Json?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, supplierId])
  @@map("accounts_payable")
}

/// Movimentações financeiras (lançamentos)
model FinancialTransaction {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  accountId   String
  account     FinancialAccount @relation(fields: [accountId], references: [id])

  type        TransactionType
  amount      Decimal         @db.Decimal(15, 2)
  balanceAfter Decimal        @db.Decimal(15, 2)

  description String
  referenceType String?       // order, purchase, receivable, payable
  referenceId   String?

  costCenterId String?
  costCenter   CostCenter?    @relation(fields: [costCenterId], references: [id])
  chartAccountId String?
  chartAccount   ChartOfAccounts? @relation(fields: [chartAccountId], references: [id])

  reconciledAt DateTime?
  metadata    Json?

  createdAt   DateTime        @default(now())

  @@index([tenantId, accountId])
  @@index([tenantId, createdAt])
  @@index([referenceType, referenceId])
  @@map("financial_transactions")
}

/// Métodos de pagamento
model PaymentMethod {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String            // Dinheiro, PIX, Cartão Crédito, Boleto, etc.
  type      PaymentMethodType @default(OTHER)
  isActive  Boolean           @default(true)

  defaultAccountId      String?
  defaultAccount        FinancialAccount? @relation(fields: [defaultAccountId], references: [id])
  feePercentage         Decimal?          @db.Decimal(5, 2)
  settlementDays        Int?
  requiresAuthorization Boolean           @default(false)
  fiscalCode            String?           @db.VarChar(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receivables    AccountsReceivable[]
  payables       AccountsPayable[]
  orderPayments  OrderPayment[]

  @@index([tenantId])
  @@map("payment_methods")
}

/// Condições de pagamento
model PaymentCondition {
  id                      String               @id @default(cuid())
  tenantId                String
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                    String               @db.VarChar(100)
  code                    String               @db.VarChar(20)
  type                    PaymentConditionType
  installments            Int                  @default(1)
  daysBetweenInstallments Int                  @default(0)
  entryPercentage         Decimal              @default(0) @db.Decimal(5, 2)
  isActive                Boolean              @default(true)

  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  orderPayments           OrderPayment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("payment_conditions")
}

/// Pagamentos do pedido (suporta split payment)
model OrderPayment {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderId             String
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethodId     String
  paymentMethod       PaymentMethod     @relation(fields: [paymentMethodId], references: [id])
  paymentConditionId  String?
  paymentCondition    PaymentCondition? @relation(fields: [paymentConditionId], references: [id])
  financialAccountId  String?
  financialAccount    FinancialAccount? @relation(fields: [financialAccountId], references: [id])

  amount              Decimal           @db.Decimal(15, 2)
  installments        Int               @default(1)
  authorizationCode   String?           @db.VarChar(50)
  notes               String?           @db.VarChar(500)

  createdAt           DateTime          @default(now())

  receivables         AccountsReceivable[]

  @@index([orderId])
  @@index([tenantId])
  @@map("order_payments")
}

/// Caixa registradora / ponto de caixa
model CashRegister {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                String            @db.VarChar(100)
  financialAccountId  String
  financialAccount    FinancialAccount  @relation(fields: [financialAccountId], references: [id])
  isActive            Boolean           @default(true)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  sessions            CashRegisterSession[]

  @@unique([tenantId, name])
  @@map("cash_registers")
}

/// Sessão de caixa (abertura/fechamento)
model CashRegisterSession {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cashRegisterId  String
  cashRegister    CashRegister      @relation(fields: [cashRegisterId], references: [id])
  operatorId      String
  operator        User              @relation("SessionOperator", fields: [operatorId], references: [id])
  closedById      String?
  closedBy        User?             @relation("SessionCloser", fields: [closedById], references: [id])
  status          CashSessionStatus @default(OPEN)

  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  openingBalance  Decimal           @db.Decimal(15, 2)
  closingBalance  Decimal?          @db.Decimal(15, 2)
  expectedBalance Decimal?          @db.Decimal(15, 2)
  difference      Decimal?          @db.Decimal(15, 2)
  notes           String?           @db.VarChar(500)

  movements       CashRegisterMovement[]
  orders          Order[]

  @@index([tenantId])
  @@index([cashRegisterId])
  @@map("cash_register_sessions")
}

/// Movimentações de caixa (suprimento/sangria)
model CashRegisterMovement {
  id              String              @id @default(cuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sessionId       String
  session         CashRegisterSession @relation(fields: [sessionId], references: [id])
  type            CashMovementType
  amount          Decimal             @db.Decimal(15, 2)
  reason          String              @db.VarChar(255)
  performedById   String
  performedBy     User                @relation("MovementPerformedBy", fields: [performedById], references: [id])

  createdAt       DateTime            @default(now())

  @@index([sessionId])
  @@map("cash_register_movements")
}

/// Conciliação bancária
model BankReconciliation {
  id          String               @id @default(cuid())
  tenantId    String

  accountId   String
  account     FinancialAccount     @relation(fields: [accountId], references: [id])

  externalId  String?              // ID no extrato
  date        DateTime
  description String
  amount      Decimal              @db.Decimal(15, 2)
  type        TransactionType

  status      ReconciliationStatus @default(PENDING)
  matchedTransactionId String?

  rawData     Json?                // dados brutos do OFX

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([tenantId, accountId])
  @@index([tenantId, status])
  @@map("bank_reconciliations")
}

/// Centros de custo
model CostCenter {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  code      String
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receivables  AccountsReceivable[]
  payables     AccountsPayable[]
  transactions FinancialTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("cost_centers")
}

/// Plano de contas (DRE hierárquico)
model ChartOfAccounts {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code      String      // 1.1.01
  name      String
  type      AccountType
  parentId  String?
  parent    ChartOfAccounts?  @relation("ChartTree", fields: [parentId], references: [id])
  children  ChartOfAccounts[] @relation("ChartTree")
  isActive  Boolean     @default(true)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  receivables  AccountsReceivable[]
  payables     AccountsPayable[]
  transactions FinancialTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("chart_of_accounts")
}

// ==========================================
// FISCAL
// ==========================================

/// Notas fiscais (NF-e, NFC-e, NFS-e)
model Invoice {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type        InvoiceType
  status      InvoiceStatus @default(DRAFT)

  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id])
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id])

  // Dados da NF
  number      String?       // número da nota
  series      String?
  accessKey   String?       // chave de acesso (44 dígitos)
  protocol    String?       // protocolo de autorização

  // Valores
  totalProducts Decimal     @default(0) @db.Decimal(15, 2)
  totalDiscount Decimal     @default(0) @db.Decimal(15, 2)
  shippingCost  Decimal     @default(0) @db.Decimal(15, 2)
  totalTax      Decimal     @default(0) @db.Decimal(15, 2)
  totalAmount   Decimal     @default(0) @db.Decimal(15, 2)

  // Impostos totais
  icmsTotal   Decimal       @default(0) @db.Decimal(15, 2)
  ipiTotal    Decimal       @default(0) @db.Decimal(15, 2)
  pisTotal    Decimal       @default(0) @db.Decimal(15, 2)
  cofinsTotal Decimal       @default(0) @db.Decimal(15, 2)

  // XML e PDF
  xmlUrl      String?
  pdfUrl      String?

  // CFOP principal
  cfop        String?

  notes       String?
  metadata    Json?

  authorizedAt DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items       InvoiceItem[]

  @@index([tenantId, status])
  @@index([tenantId, accessKey])
  @@index([tenantId, orderId])
  @@map("invoices")
}

/// Itens da nota fiscal
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productName String
  ncm         String?
  cfop        String?
  cst         String?  // CST ou CSOSN

  quantity    Int
  unitPrice   Decimal  @db.Decimal(15, 4)
  totalPrice  Decimal  @db.Decimal(15, 2)

  // Impostos por item
  icmsBase    Decimal  @default(0) @db.Decimal(15, 2)
  icmsRate    Decimal  @default(0) @db.Decimal(5, 2)
  icmsAmount  Decimal  @default(0) @db.Decimal(15, 2)

  ipiBase     Decimal  @default(0) @db.Decimal(15, 2)
  ipiRate     Decimal  @default(0) @db.Decimal(5, 2)
  ipiAmount   Decimal  @default(0) @db.Decimal(15, 2)

  pisBase     Decimal  @default(0) @db.Decimal(15, 2)
  pisRate     Decimal  @default(0) @db.Decimal(5, 2)
  pisAmount   Decimal  @default(0) @db.Decimal(15, 2)

  cofinsBase  Decimal  @default(0) @db.Decimal(15, 2)
  cofinsRate  Decimal  @default(0) @db.Decimal(5, 2)
  cofinsAmount Decimal @default(0) @db.Decimal(15, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

/// Regras fiscais por NCM/UF
model TaxRule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  ncm       String?  // NCM aplicável (pode ser wildcard)
  stateFrom String?  // UF origem
  stateTo   String?  // UF destino
  taxRegime TaxRegime?

  cfop      String?
  cst       String?

  icmsRate  Decimal? @db.Decimal(5, 2)
  icmsStRate Decimal? @db.Decimal(5, 2)
  ipiRate   Decimal? @db.Decimal(5, 2)
  pisRate   Decimal? @db.Decimal(5, 2)
  cofinsRate Decimal? @db.Decimal(5, 2)

  isActive  Boolean  @default(true)
  priority  Int      @default(0) // para resolver conflitos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, ncm])
  @@index([tenantId, stateFrom, stateTo])
  @@map("tax_rules")
}

/// CFOPs cadastrados
model Cfop {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code        String
  description String
  operationType String // entrada, saida, transferencia

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, code])
  @@map("cfops")
}

// ==========================================
// CRM
// ==========================================

/// Clientes
model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  email       String?
  phone       String?
  document    String?  // CPF ou CNPJ
  documentType String? // CPF ou CNPJ
  tradeName   String?  // nome fantasia (PJ)

  // Scoring e segmentação
  score       Int      @default(0)
  tags        String[] @default([])
  segment     String?

  notes       String?
  metadata    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  addresses    CustomerAddress[]
  orders       Order[]
  quotations   Quotation[]
  receivables  AccountsReceivable[]
  invoices     Invoice[]
  interactions CustomerInteraction[]

  @@index([tenantId])
  @@index([tenantId, document])
  @@index([tenantId, email])
  @@index([tenantId, name])
  @@map("customers")
}

/// Endereços do cliente
model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label       String?  // Casa, Trabalho, etc.
  street      String
  number      String
  complement  String?
  neighborhood String
  city        String
  state       String
  zipCode     String
  country     String   @default("BR")
  isDefault   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("customer_addresses")
}

/// Interações com cliente (histórico)
model CustomerInteraction {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type        InteractionType
  subject     String?
  content     String
  userId      String?
  user        User?           @relation(fields: [userId], references: [id])

  createdAt   DateTime        @default(now())

  @@index([customerId])
  @@map("customer_interactions")
}

/// Leads (pré-clientes)
model Lead {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  email       String?
  phone       String?
  company     String?
  source      String?    // website, indicação, marketplace
  status      LeadStatus @default(NEW)
  score       Int        @default(0)

  assignedTo  String?    // userId
  notes       String?

  convertedAt DateTime?
  customerId  String?    // se convertido

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId, status])
  @@map("leads")
}

// ==========================================
// INTEGRAÇÕES / MARKETPLACES
// ==========================================

/// Conexões com marketplaces
model MarketplaceConnection {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  marketplace MarketplaceType
  accountName String          // nome da conta no marketplace
  sellerId    String?         // ID do vendedor no marketplace

  // Tokens (criptografados)
  accessToken  String?
  refreshToken String?
  tokenExpiresAt DateTime?

  isActive    Boolean         @default(true)
  lastSyncAt  DateTime?
  syncStatus  SyncStatus      @default(PENDING)

  settings    Json            @default("{}") // configurações específicas
  metadata    Json?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  listings    MarketplaceListing[]
  syncLogs    MarketplaceSyncLog[]
  webhookEvents WebhookEvent[]

  @@index([tenantId, marketplace])
  @@map("marketplace_connections")
}

/// Anúncios vinculados no marketplace
model MarketplaceListing {
  id            String          @id @default(cuid())
  connectionId  String
  connection    MarketplaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  productId     String
  product       Product         @relation(fields: [productId], references: [id])

  externalId    String          // ID do anúncio no marketplace
  externalUrl   String?
  title         String?
  status        ListingStatus   @default(ACTIVE)

  price         Decimal?        @db.Decimal(15, 2)
  stock         Int?
  lastSyncAt    DateTime?

  metadata      Json?           // dados extras do marketplace

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([connectionId, externalId])
  @@index([productId])
  @@map("marketplace_listings")
}

/// Logs de sincronização
model MarketplaceSyncLog {
  id            String          @id @default(cuid())
  connectionId  String
  connection    MarketplaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  syncType      String          // orders, stock, prices, listings
  status        SyncStatus
  itemsProcessed Int            @default(0)
  itemsFailed    Int            @default(0)
  errors        Json?           // detalhes dos erros
  duration      Int?            // em ms

  startedAt     DateTime
  completedAt   DateTime?

  @@index([connectionId, syncType])
  @@index([connectionId, startedAt])
  @@map("marketplace_sync_logs")
}

/// Eventos de webhook recebidos
model WebhookEvent {
  id            String          @id @default(cuid())
  connectionId  String?
  connection    MarketplaceConnection? @relation(fields: [connectionId], references: [id])

  marketplace   MarketplaceType
  eventType     String          // orders, items, questions, messages
  externalId    String          // ID do recurso
  payload       Json            // payload completo
  processed     Boolean         @default(false)
  processedAt   DateTime?
  error         String?
  retryCount    Int             @default(0)

  createdAt     DateTime        @default(now())

  @@index([marketplace, processed])
  @@index([connectionId, eventType])
  @@map("webhook_events")
}

// ==========================================
// NOTIFICAÇÕES
// ==========================================

/// Notificações do sistema
model Notification {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId      String?
  user        User?               @relation(fields: [userId], references: [id])

  type        NotificationType    @default(IN_APP)
  priority    NotificationPriority @default(MEDIUM)
  title       String
  message     String
  data        Json?               // dados extras (link, entityType, entityId)

  readAt      DateTime?
  sentAt      DateTime?

  createdAt   DateTime            @default(now())

  @@index([tenantId, userId, readAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

/// Preferências de notificação por usuário
model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String
  event     String           // order_created, stock_low, etc.
  channels  NotificationType[] // quais canais quer receber

  @@unique([userId, event])
  @@map("notification_preferences")
}
